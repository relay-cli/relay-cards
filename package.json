{
  "name": "@relay-cli/server-cards",
  "version": "0.1.0",
  "description": "Runs a server command and presents its requests, structured output, errors, and process events as readable terminal cards.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "relay-cards": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "demo": "tsx src/cli.tsx -- tsx examples/demo-server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
